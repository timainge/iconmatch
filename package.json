{
  "name": "iconmatch",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:slow": "ICONMATCH_SLOW_TESTS=1 vitest run",
    "fixtures": "tsx --conditions=source packages/pipeline/scripts/make-fixtures.ts",
    "fixtures:vectors": "tsx --conditions=source packages/pipeline/scripts/make-reference-vectors.ts",
    "bench": "tsx --conditions=source packages/pipeline/scripts/bench.ts",
    "build": "npm run build -w iconmatch",
    "readme": "tsx --conditions=source packages/pipeline/scripts/sync-readme.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "eval"
  ]
}
