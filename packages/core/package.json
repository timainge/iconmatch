{
  "name": "@iconmatch/core",
  "version": "0.1.0",
  "description": "Semantic icon matching for user-defined categories: hybrid keyword + vector search over Tabler icons, with a lettered fallback.",
  "keywords": [
    "icons",
    "tabler",
    "semantic search",
    "embeddings",
    "icon picker",
    "category icons"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timainge/iconmatch.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/timainge/iconmatch/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/timainge/iconmatch/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./embedder-transformers": {
      "source": "./src/embedders/transformers.ts",
      "types": "./dist/embedders/transformers.d.ts",
      "default": "./dist/embedders/transformers.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0"
  }
}
